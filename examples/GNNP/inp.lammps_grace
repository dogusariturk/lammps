# This is an example of the driver of `GRACE' <https://gracemaker.readthedocs.io/en/latest/>.
# This driver is developed by AdvanceSoft Corp <https://www.advancesoft.jp>.
# and modified by Doguhan Sariturk <dogu.sariturk@gmail.com>.
# Before you use this driver, you have to install python3, tensorflow, and tensorpotential.
# See <https://gracemaker.readthedocs.io/en/latest/installation.html> for the installation of GRACE.

# NOTE:
#   1) the units must be metal
#   2) the 3D periodic boundary condition must be used
#   3) cannot use MPI parallelization, only OpenMP or GPU

units         metal
boundary      p p p
atom_style    atomic

pair_style    gnnp ../../src/ML-GNNP
#pair_style    gnnp/d3 ../../src/ML-GNNP
#pair_style    gnnp/gpu ../../src/ML-GNNP
#pair_style    gnnp/d3/gpu ../../src/ML-GNNP

read_data     ./dat.lammps

pair_coeff    * *  Grace GRACE-2L-OMAT Zr O
#pair_coeff    * *  Grace GRACE-1L-OMAT Zr O
#pair_coeff    * *  Grace GRACE-2L-OAM Zr O
#pair_coeff    * *  Grace GRACE-1L-OAM Zr O
#pair_coeff    * *  Grace GRACE-2L-MP-r6 Zr O
#pair_coeff    * *  Grace GRACE-2L-MP-r5 Zr O

dump          myDump all custom 10 xyz.lammpstrj id element x y z
dump_modify   myDump sort id element Zr O

thermo_style  custom step time cpu pe ke etotal temp press vol density
thermo        10

velocity      all create 300.0 12345
fix           myEnse all npt temp 300.0 300.0 0.1 aniso 1.0 1.0 1.0
timestep      5.0e-4
run           10000
